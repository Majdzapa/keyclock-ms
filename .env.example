# ═══════════════════════════════════════════════════════════
# CertManager — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
#
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ── Database (MariaDB) ──────────────────────────────────────
DB_ROOT_PASSWORD=rootpassword
DB_NAME=certmanager
DB_USER=certuser
DB_PASSWORD=certpassword
DB_PORT=3306

# ── Keycloak ────────────────────────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin
KC_REALM=certmanager-realm
KC_PORT=8080

# ── Mail (Mailpit) ──────────────────────────────────────────
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# ── Backend ─────────────────────────────────────────────────
BACKEND_PORT=8081
NOTIFICATION_ENABLED=true
NOTIFICATION_ADMIN_EMAIL=admin@certmanager.local

# ── Frontend ────────────────────────────────────────────────
FRONTEND_PORT=3000
# Must be the public URL that the BROWSER reaches (not docker-internal)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_CLIENT_ID=certmanager-frontend
VITE_API_URL=http://localhost:8081/api/v1
